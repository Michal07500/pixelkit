{
  "name": "pixelkit",
  "version": "1.0.0",
  "description": "PIXEL KIT: Roblox Studio course, site, videos and Higgsfield generation",
  "scripts": {
    "seedance": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "build:pdf": "node scripts/build-pdfs.mjs",
    "build:videos": "node videos/build-all.mjs --skip-existing",
    "build:video": "node videos/build-episode.mjs",
    "release": "node scripts/release.mjs",
    "build:carousels": "node scripts/build-carousels.mjs",
    "hf:plan": "tsx scripts/hf-generate.ts",
    "hf:generate": "tsx scripts/hf-generate.ts --yes",
    "build:ads": "node videos/build-all.mjs ads"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michal07500/pixelkit.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Michal07500/pixelkit/issues"
  },
  "homepage": "https://github.com/Michal07500/pixelkit#readme",
  "dependencies": {
    "@higgsfield/client": "^0.2.6",
    "dotenv": "^18.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "adm-zip": "^0.6.1",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
